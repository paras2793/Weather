# Optional API endpoint overrides. Defaults are the public Open-Meteo endpoints.
VITE_GEOCODING_API=https://geocoding-api.open-meteo.com/v1/search
VITE_WEATHER_API=https://api.open-meteo.com/v1/forecast
VITE_AQI_API=https://air-quality-api.open-meteo.com/v1/air-quality

# Country code used only to rank matching suggestions; other countries remain searchable.
# Set to an empty value to disable the preference.
VITE_PREFERRED_COUNTRY_CODE=IN

# OpenFreeMap's dark style is used by default. A compatible MapLibre style URL can be supplied.
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/dark
